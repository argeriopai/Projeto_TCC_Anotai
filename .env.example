claude# =============================================================================
# ANOTAÍ - .env.example
# Copie este arquivo para apps/api/.env e preencha os valores reais.
#   cp .env.example apps/api/.env
#
# NUNCA commite o arquivo .env com valores reais no repositório.
# =============================================================================

# -----------------------------------------------------------------------------
# BANCO DE DADOS PostgreSQL (deve bater com o docker-compose.yml)
# -----------------------------------------------------------------------------
DB_USER=anotai_user
DB_PASSWORD=anotai_pass_2026
DB_NAME=anotai_db
DB_HOST=localhost
DB_PORT=5432

# URL completa usada pelo Prisma
DATABASE_URL="postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=public"

# -----------------------------------------------------------------------------
# REDIS (sessões e filas de notificação - RF14)
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL="redis://${REDIS_HOST}:${REDIS_PORT}"

# -----------------------------------------------------------------------------
# AUTENTICAÇÃO JWT
# Gere uma chave segura com:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# -----------------------------------------------------------------------------
JWT_SECRET=substitua_por_uma_chave_segura_gerada_com_o_comando_acima
JWT_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# SERVIDOR API
# -----------------------------------------------------------------------------
PORT=3333
NODE_ENV=development

# -----------------------------------------------------------------------------
# UPLOAD DE ARQUIVOS (Anexos - RF15, RF16)
# -----------------------------------------------------------------------------
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
